# --- Postgres (Neon / Vercel Postgres / local) ---
# Exemplo Neon: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/trico?schema=public"

# Auth.js — OBRIGATÓRIO em produção (≥32 caracteres aleatórios)
# openssl rand -base64 32
AUTH_SECRET="substituir-por-segredo-aleatorio-com-pelo-menos-32-chars"
AUTH_URL="http://127.0.0.1:43124"
NEXTAUTH_URL="http://127.0.0.1:43124"

# OAuth opcional
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# Emails com acesso admin (separados por vírgula). Não commits emails reais.
# Promoção automática exige email verificado (OAuth) ou bootstrap (0 admins).
ADMIN_EMAILS="admin@example.com"

# Contacto público no rodapé (opcional)
# NEXT_PUBLIC_CONTACT_EMAIL=contacto@example.com

# Email transaccional (Resend) — confirmação de conta + boas-vindas
# https://resend.com — verifica o domínio do FROM
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Tricô <noreply@oteudominio.com>"
# NEXT_PUBLIC_APP_URL=https://trico-agent.vercel.app

# IA opcional
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Ingestão + Cron Vercel — OBRIGATÓRIO em produção (≥16 chars)
# openssl rand -hex 24
INGEST_SECRET="substituir-segredo-ingestao-local"
# CRON_SECRET=igual-ao-ingest-ou-outro

# APIs de notícias (opcional — sem elas usa só RSS)
# NEWSDATA_API_KEY=
# GNEWS_API_KEY=
# NEWS_API_KEY=

# Forçar SSL do pg (Neon/Vercel costumam precisar)
# PGSSL=1
