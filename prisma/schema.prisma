// Schema Prisma da Tricô — PostgreSQL (Neon / Vercel Postgres / local).
// Modelos: User/Account/Session (Auth.js), preferências, RSS, peças (resumos).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js / NextAuth ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  plan          String    @default("gratuito") // gratuito | premium
  role          String    @default("user") // user | admin
  premiumUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  preferences   UserPreference?
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Preferências do utilizador ---

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  sectorsJson   String   @default("[]") // JSON: SectorId[]
  notifications String   @default("app") // app | email | alertas
  onboarded     Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Ingestão RSS ---

model FeedSource {
  id        String    @id @default(cuid())
  name      String
  url       String    @unique
  sectorHint String?  // sector sugerido (opcional)
  active    Boolean   @default(true)
  lastFetch DateTime?
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Article {
  id          String   @id @default(cuid())
  feedId      String
  guid        String
  title       String
  summary     String   @default("")
  content     String   @default("")
  url         String
  publishedAt DateTime
  sectorId    String?  // economia | politica | ...
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  feed        FeedSource @relation(fields: [feedId], references: [id], onDelete: Cascade)
  pieceLinks  PieceSource[]

  @@unique([feedId, guid])
  @@index([sectorId, publishedAt])
  @@index([processed])
}

// --- Peças (resumos agregados) ---

model Piece {
  id           String   @id @default(cuid())
  sectorId     String
  title        String
  summary      String
  fullSummary  String
  timeWindow   String   // hora | dia | semana | ano
  themeId      String
  impact       String   @default("medio") // alto | medio | baixo
  isBreaking   Boolean  @default(false)
  sourceCount  Int      @default(1)
  publishedAt  DateTime
  aiProvider   String   @default("heuristic")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sources      PieceSource[]

  @@index([sectorId, timeWindow, publishedAt])
  @@index([themeId])
}

model PieceSource {
  id        String  @id @default(cuid())
  pieceId   String
  articleId String
  piece     Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([pieceId, articleId])
}

model IngestRun {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  status       String   @default("running") // running | ok | error
  fetchedCount Int      @default(0)
  createdPieces Int     @default(0)
  message      String   @default("")
}

// --- Pagamentos Premium (2000 Kz) ---

model Payment {
  id          String    @id @default(cuid())
  userId      String
  amountKz    Int       @default(2000)
  currency    String    @default("AOA")
  status      String    @default("pending") // pending | confirmed | cancelled
  method      String    @default("manual") // manual | multicaixa | transfer
  reference   String?
  note        String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// --- Publicidade de parceiros ---

model AdCampaign {
  id           String    @id @default(cuid())
  partnerName  String
  headline     String
  body         String    @default("")
  ctaLabel     String    @default("Saber mais")
  targetUrl    String
  // feed-top | feed-mid | feed-sidebar | landing-mid | piece-bottom | sector-top
  placement    String
  // null = todos; senão sector id (economia, saude, ...)
  sectorId     String?
  active       Boolean   @default(true)
  priority     Int       @default(0)
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  accent       String    @default("navy") // navy | terracotta | teal | emerald
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, placement, sectorId])
  @@index([startsAt, endsAt])
}
